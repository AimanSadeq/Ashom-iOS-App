# Environment variables (secrets)
.env
.env.*

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is intentionally COMMITTED. Ignoring it meant deploys
# resolved dependency versions afresh each time and were not reproducible;
# render.yaml now uses `npm ci`, which requires the lockfile to be present.

# Database
db/
*.db
*.sqlite
*.sqlite3

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Build files
# frontend/build is produced by the deploy build step and must NOT be committed:
# a stale committed bundle was being served in production while the source had
# moved on. Run `git rm -r --cached frontend/build` once to untrack it.
dist/
build/
frontend/build/
mobile_app/build/
mobile_app/.dart_tool/

# Temporary files
tmp/
temp/
*.tmp

# Generated quant data (run `node server/generate-price-history.js` to regenerate)
server/data/

# User uploads (if any)
uploads/

# Test coverage
coverage/

# PM2
.pm2/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache
nul
